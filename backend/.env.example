PORT=3000
HOST=0.0.0.0
DATABASE_PATH=./data/smartflow.db

# External AI Model Configuration (Google Gemini)
# Paste your Gemini API key from https://aistudio.google.com/ below:
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# Fallback to local intelligent classification engine if external API is unavailable
AI_FALLBACK_ENABLED=true

# Debug & Logging Configuration
LOG_LEVEL=debug
DEBUG=true
FORCE_AI_FAILURE=false
